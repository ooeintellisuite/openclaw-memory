# OpenClaw Memory System (example)
# Copy values into your workspace .env and keep permissions strict (chmod 600).

export OPENCLAW_DIR="$HOME/.openclaw"
export WORKSPACE_DIR="$HOME/clawd"
export OPENROUTER_API_KEY="your-openrouter-key"
export OBSERVER_MODEL="google/gemini-2.5-flash"
# Optional:
# export OBSERVER_API_URL="https://openrouter.ai/api/v1/chat/completions"
# export LOOKBACK_MIN="20"
# export OBSERVER_DRY_RUN="false"
